{
  "regions": ["pdx1"],
  "functions": {
    "api/*.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/admin-v2", "destination": "/api/health?scope=admin" },
    { "source": "/api/training-library", "destination": "/api/health?scope=library" },
    { "source": "/api/personal-tools", "destination": "/api/health?scope=tools" },
    { "source": "/api/personal-plans", "destination": "/api/health?scope=plans" },
    { "source": "/api/strava-webhook", "destination": "/api/health?scope=strava_webhook" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
