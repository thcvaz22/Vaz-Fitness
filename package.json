{
  "name": "vaz-fitness",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Vaz Fitness — treino adaptativo com AION IA",
  "scripts": {
    "release:sync": "node scripts/sync-release-manifests.mjs",
    "release:check": "node scripts/check-release-consistency.mjs",
