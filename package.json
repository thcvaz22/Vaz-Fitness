    "@capacitor/local-notifications": "8.3.1",
    "@google/genai": "2.22.0",
    "@neondatabase/serverless": "1.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": "22.x"
